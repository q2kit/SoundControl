    "%lld%%" : {
      "comment" : "A small label showing the percentage of the volume.",
      "isCommentAutoGenerated" : true
    },
    "+%lld" : {
      "comment" : "A label that shows the number of apps that are using a device. The number is the difference between the total number of apps and the number of apps that are shown in the row.",
